# Kilo indexing exclusions — Guía TES
# Evita indexar ruido/datos intermedios en el índice semántico (Qdrant).
# El indexador respeta este archivo y .gitignore; los patrones se auto-migran
# a reglas deny de acceso en Kilo.

# Datos intermedios del proyecto de búsqueda semántica
sem_search/

# Área de trabajo temporal
pool/

# Embeddings generados (no son contenido fuente)
base_datos/embeddings/

# Clones de repos externos / datasets de investigación en bruto (no son corpus de la app).
# Los archivos se conservan intactos en disco; solo se excluyen del índice semántico.
# Cuando la app necesite estos datos, se leen directamente desde el repo.
external_datasets/
